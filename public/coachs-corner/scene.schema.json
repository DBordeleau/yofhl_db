{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:yofhl:coachs-corner:scene:1",
  "title": "Coach's Corner scene format v1",
  "description": "Ordered, text-timed dialogue, stage actions and pauses. Cross-reference validation against the asset manifest is also required.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "assetManifest": {
      "type": "string",
      "pattern": "^/"
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "text"
        },
        "wordUnit": {
          "const": "whitespace-token"
        },
        "autoPunctuationPauses": {
          "const": false
        },
        "defaultDelivery": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "defaultWpm": {
          "type": "number",
          "minimum": 40,
          "maximum": 400
        },
        "defaultRunHoldMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "defaultLineHoldMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "poseTransitionMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "mouthTransitionMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "mouthCycleMs": {
          "type": "integer",
          "minimum": 80,
          "maximum": 2000
        }
      },
      "required": [
        "mode",
        "wordUnit",
        "autoPunctuationPauses",
        "defaultDelivery",
        "defaultWpm",
        "defaultRunHoldMs",
        "defaultLineHoldMs",
        "poseTransitionMs",
        "mouthTransitionMs",
        "mouthCycleMs"
      ]
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reducedMotion": {
          "const": "disable-motion"
        },
        "keepTypography": {
          "const": true
        }
      },
      "required": [
        "reducedMotion",
        "keepTypography"
      ]
    },
    "characters": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/character"
      },
      "minProperties": 1
    },
    "deliveryStyles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/delivery"
      },
      "minProperties": 1,
      "required": [
        "normal"
      ]
    },
    "initialState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "poses": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/poseId"
          },
          "minProperties": 1
        },
        "props": {
          "$ref": "#/definitions/props"
        }
      },
      "required": [
        "poses",
        "props"
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/say"
          },
          {
            "$ref": "#/definitions/stage"
          },
          {
            "$ref": "#/definitions/pause"
          }
        ]
      }
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "title",
    "assetManifest",
    "timing",
    "accessibility",
    "characters",
    "deliveryStyles",
    "initialState",
    "events"
  ],
  "definitions": {
    "poseId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "monitorPower": {
          "enum": [
            "off",
            "on"
          ]
        }
      },
      "required": []
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "seat": {
          "enum": [
            "left",
            "right"
          ]
        },
        "idlePose": {
          "$ref": "#/definitions/poseId"
        },
        "talkPose": {
          "$ref": "#/definitions/poseId"
        }
      },
      "required": [
        "name",
        "seat",
        "idlePose",
        "talkPose"
      ]
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "effect": {
          "enum": [
            "none",
            "bob",
            "shake"
          ]
        },
        "offsetPx": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "rotationDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "hz": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        }
      },
      "required": [
        "effect",
        "offsetPx",
        "rotationDeg",
        "hz"
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fontScale": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 2
            },
            "fontWeight": {
              "enum": [
                100,
                200,
                300,
                400,
                500,
                600,
                700,
                800,
                900
              ]
            },
            "fontStyle": {
              "enum": [
                "normal",
                "italic"
              ]
            }
          },
          "required": [
            "fontScale",
            "fontWeight",
            "fontStyle"
          ]
        },
        "textMotion": {
          "$ref": "#/definitions/motion"
        },
        "characterMotion": {
          "$ref": "#/definitions/motion"
        }
      },
      "required": [
        "typography",
        "textMotion",
        "characterMotion"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "delivery": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "wpm": {
          "type": "number",
          "minimum": 40,
          "maximum": 400
        },
        "pose": {
          "$ref": "#/definitions/poseId"
        },
        "holdAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      },
      "required": [
        "text"
      ]
    },
    "say": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "type": {
          "const": "say"
        },
        "speaker": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "delivery": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "wpm": {
          "type": "number",
          "minimum": 40,
          "maximum": 400
        },
        "pose": {
          "$ref": "#/definitions/poseId"
        },
        "listenerPoses": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/poseId"
          },
          "minProperties": 0
        },
        "afterPose": {
          "$ref": "#/definitions/poseId"
        },
        "ending": {
          "enum": [
            "complete",
            "interrupted",
            "self-cutoff"
          ]
        },
        "interruptedBy": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "holdAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/run"
          }
        }
      },
      "required": [
        "id",
        "type",
        "speaker",
        "runs"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "ending"
            ],
            "properties": {
              "ending": {
                "const": "interrupted"
              }
            }
          },
          "then": {
            "required": [
              "interruptedBy"
            ]
          },
          "else": {
            "not": {
              "required": [
                "interruptedBy"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "ending"
            ],
            "properties": {
              "ending": {
                "enum": [
                  "interrupted",
                  "self-cutoff"
                ]
              }
            }
          },
          "then": {
            "required": [
              "holdAfterMs"
            ],
            "properties": {
              "holdAfterMs": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "type": {
          "const": "stage"
        },
        "direction": {
          "type": "string",
          "minLength": 1
        },
        "poses": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/poseId"
          },
          "minProperties": 0
        },
        "props": {
          "$ref": "#/definitions/props"
        },
        "transitionMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "caption": {
          "enum": [
            "keep",
            "clear"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "direction",
        "poses",
        "transitionMs",
        "durationMs",
        "caption"
      ]
    },
    "pause": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "type": {
          "const": "pause"
        },
        "direction": {
          "type": "string",
          "minLength": 1
        },
        "poses": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/poseId"
          },
          "minProperties": 0
        },
        "transitionMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "caption": {
          "enum": [
            "keep",
            "clear"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "durationMs",
        "caption"
      ]
    }
  }
}
