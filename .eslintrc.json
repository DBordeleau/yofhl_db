{
  "root": true,
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "import/no-restricted-paths": ["error", { "zones": [{
      "target": ".",
      "from": "./lib/fantrax",
      "except": ["./live-season.ts", "./config.ts", "./season.ts", "./schedule.ts"],
      "message": "Outside lib/fantrax/, import the live season entry point (lib/fantrax/live-season.ts), config, season or schedule."
    }] }]
  },
  "overrides": [
    {
      "files": ["lib/fantrax/**"],
      "rules": { "import/no-restricted-paths": "off" }
    },
    {
      "files": ["lib/coachs-corner/production/**", "db/schema.ts"],
      "rules": {
        "import/no-restricted-paths": ["error", { "zones": [{
          "target": ".",
          "from": "./lib/fantrax",
          "except": ["./live-season.ts", "./config.ts", "./season.ts", "./schedule.ts", "./fantrax-client.ts"],
          "message": "Outside lib/fantrax/, import the live season entry point (lib/fantrax/live-season.ts), config, season or schedule; the Coach's Corner production code and the database schema may also import the Fantrax client."
        }] }]
      }
    }
  ]
}
