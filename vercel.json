{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "codex/**": false
    }
  },
  "crons": [
    { "path": "/api/cron/fantrax?slot=00:00", "schedule": "0 0 * * *" },
    { "path": "/api/cron/fantrax?slot=01:00", "schedule": "0 1 * * *" },
    { "path": "/api/cron/fantrax?slot=02:00", "schedule": "0 2 * * *" },
    { "path": "/api/cron/fantrax?slot=03:00", "schedule": "0 3 * * *" },
    { "path": "/api/cron/fantrax?slot=03:30", "schedule": "30 3 * * *" },
    { "path": "/api/cron/fantrax?slot=04:30", "schedule": "30 4 * * *" }
  ]
}
