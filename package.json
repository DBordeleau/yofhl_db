{
  "name": "yofhl_db",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "coachs:prepare": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/coachs-corner/production.ts prepare",
    "coachs:facts": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/coachs-corner/production.ts facts",
    "coachs:stats": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/coachs-corner/production.ts stats",
    "coachs:check": "node --import tsx scripts/coachs-corner/production.ts check",
    "test:coachs": "node --import tsx --test lib/coachs-corner/*.test.ts lib/coachs-corner/production/*.test.ts lib/data/coachs-corner.test.ts",
    "draft:sync": "node --env-file-if-exists=.env.local --import tsx companion/scripts/sync.ts",
    "draft:dev": "node node_modules/next/dist/bin/next dev companion --hostname 127.0.0.1 --port 3100",
    "draft:build": "node node_modules/next/dist/bin/next build companion",
    "draft:start": "node node_modules/next/dist/bin/next start companion --hostname 127.0.0.1 --port 3100",
    "test:companion": "node --import tsx --test companion/lib/*.test.ts",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/db/migrate.ts",
    "db:seed:branding": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/db/seed-team-branding.ts",
    "test:lottery": "node --import tsx --test lib/lottery/*.test.ts",
    "test:draft": "node --import tsx --test lib/draft.test.ts lib/draft/*.test.ts",
    "test:history": "node --import tsx --test scripts/db/lib/history.test.ts scripts/db/lib/draft-development.test.ts",
    "test:owners": "node --import tsx --test lib/owner/*.test.ts",
    "test:data": "node --import tsx --test lib/data/*.test.ts",
    "test:performance": "node --import tsx --test lib/result-cache.test.ts",
    "test:browsing": "node --import tsx --test lib/search/*.test.ts lib/compare/*.test.ts lib/share/*.test.ts lib/explore.test.ts",
    "test:snapshot": "node --import tsx --test lib/fantrax/*.test.ts",
    "test:keepers": "node --import tsx --test lib/keepers/*.test.ts",
    "db:import:history": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/db/import-history.ts",
    "db:sync:logos": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/db/sync-logos.ts",
    "db:import": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/db/import.ts",
    "db:verify": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/db/verify.ts",
    "coachs:assets": "node scripts/coachs-corner/assets.mjs",
    "prebuild": "npm run coachs:assets",
    "predev": "npm run coachs:assets",
    "test:coachs:production": "node scripts/coachs-corner/verify-publishing.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@types/cors": "^2.8.17",
    "@vercel/blob": "^2.8.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.3",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^11.15.0",
    "next": "^15.5.27",
    "postgres": "^3.4.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^5.4.0",
    "recharts": "^3.3.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
